# 💧 DRIP Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# For Railway: add these as Variables in the dashboard.

# Solana RPC (Helius recommended)
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Helius API key (dashboard.helius.dev) — required for getTokenAccounts DAS API
HELIUS_API_KEY=your_helius_api_key_here

# PumpPortal API key (optional — if not set, uses trade-local with treasury signature)
# PUMPPORTAL_API_KEY=your_pumpportal_key_here

# Token mint address (pump.fun token you are redistributing fees for)
TOKEN_MINT=your_token_mint_address_here
# TOKEN_DECIMALS=6

# Treasury wallet (base58 private key) — receives creator fees and sends drip
TREASURY_PRIVATE_KEY=your_treasury_private_key_base58_here

# Supabase — required for holders cache + drip_history
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Excluded wallets (not eligible for drip distribution)
DEV_WALLET=your_dev_wallet_address
# WASH_WALLET_1=wash_wallet_1_address
# WASH_WALLET_2=wash_wallet_2_address
