# PepeDrip Site — Vercel Environment Variables
# Add these in Vercel Dashboard → Settings → Environment Variables

# Supabase (required for Live Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Token config (for dashboard filtering + links)
NEXT_PUBLIC_TOKEN_MINT=your_token_mint_address
NEXT_PUBLIC_TOKEN_SUPPLY=1000000000
NEXT_PUBLIC_PUMP_FUN_URL=https://pump.fun/coin/your_token_mint_address
